# Copy to `process-compose.yaml`, which is git-ignored, and edit there.
#
# The registry. Portable Dev lists a process here when — and only when — its
# `environment` declares a `PORT`, and refuses to start if any of them falls
# outside `PORT_RANGE`. That range is declared in .env and made true by
# `make setup` and `make firewall`; outside it a port is authorized by nothing.
#
# Every dev server must bind $BIND_ADDR. Not 127.0.0.1 (unreachable through the
# tunnel) and not 0.0.0.0 (published to the LAN).
version: "0.5"

# process-compose loads .env, so PORT from there leaks into every process that
# does not set its own. Always give each process its own PORT= — one that no
# other process, and nothing already running on this host, has taken.

environment:
  - "BIND_ADDR=${BIND_ADDR:-10.99.99.1}"

processes:
  # The tunnel. No PORT= — it is the way in, not a thing on the list.
  cloudflared:
    description: Cloudflare Tunnel
    working_dir: .
    command: cloudflared tunnel run --token-file .tunnel-token

  # This app's own index page. It deliberately declares no PORT=, so it takes
  # PORT from .env and does not list itself among the dev servers.
  portable-dev:
    description: This index page
    working_dir: .
    command: cargo run --release --quiet

  # Replace these with your own repos. Ports are deterministic per repo: assign
  # once, inside PORT_RANGE, and do not reuse. See MANAGED-REPO.md for what a
  # repository has to do to be startable from here.

  # A front end with no back end of its own: the bundler's dev server is the
  # whole app, so it is what runs.
  example-web:
    description: Example front end
    disabled: true
    working_dir: ../example-web
    command: aube run dev -- --host $BIND_ADDR --port $PORT --strictPort
    environment:
      - PORT=18588
      - ICON=public/logo.svg # optional; relative to working_dir. Auto-detected otherwise.
    readiness_probe:
      http_get: { host: $BIND_ADDR, port: 18588, path: / }

  # An app whose back end serves BOTH its API and its built UI. Start the back
  # end, not the bundler: `aube run dev` here would return the page and 404
  # every request the page makes.
  example-app:
    description: Example API + UI
    disabled: true
    working_dir: ../example-app
    command: make web && cargo run --release --quiet
    environment:
      - PORT=18589
