# Copy to `process-compose.yaml`, which is git-ignored, and edit there.
#
# The registry. Portable Dev lists a process here when — and only when — its
# `environment` declares a `PORT`, and refuses to start if any of them falls
# outside `PORT_RANGE` — outside it, nothing authorizes the port (see README).
#
# Every dev server must bind $BIND_ADDR. Not 127.0.0.1 (unreachable through the
# tunnel) and not 0.0.0.0 (published to the LAN).
version: "0.5"

# process-compose loads .env, so PORT from there leaks into every process that
# does not set its own. Always give each process its own PORT= — one that no
# other process, and nothing already running on this host, has taken.

environment:
  - "BIND_ADDR=${BIND_ADDR:-10.99.99.1}"

processes:
  # Replace these two with your own repos. Ports are deterministic per repo:
  # assign once, inside PORT_RANGE, and do not reuse.
  example-vite:
    description: Example Vite app
    disabled: true
    working_dir: ../example-vite
    command: aube run dev -- --host $BIND_ADDR --port $PORT --strictPort
    environment:
      - PORT=8789
      - ICON=public/logo.svg # optional; relative to working_dir
    readiness_probe:
      http_get: { host: $BIND_ADDR, port: 8789, path: / }

  example-api:
    description: Example API
    disabled: true
    working_dir: ../example-api
    command: cargo run
    environment:
      - PORT=8790
