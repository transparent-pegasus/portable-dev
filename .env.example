# These must match the gateway that fronts this host: the address it dials, and the
# ports its firewall rule and access policy cover. Copy the values; do not read the
# gateway's own config from here, it may hold credentials.
BIND_ADDR=10.99.99.1
PORT_RANGE=8787-8799

# Portable Dev's own port. Must be inside PORT_RANGE, and must not collide with
# anything else already listening there.
PORT=8788
