# --- the address and the covered range ---------------------------------------
# Portable Dev owns both. BIND_ADDR is the alias every server here binds;
# PORT_RANGE is the contiguous range the Cloudflare Access destination and the
# nftables drop rule are made to cover. Size it once with slack: widening later
# costs one `make setup` and one `make firewall`.
BIND_ADDR=10.99.99.1
PORT_RANGE=18586-18599

# Portable Dev's own port. Must be inside PORT_RANGE.
PORT=18586

# --- Cloudflare Zero Trust ---------------------------------------------------
# Needed by `make setup` only. This file is git-ignored; keep it that way, and
# never commit a filled-in copy.
#
# CLOUDFLARE_API_TOKEN needs Account: Cloudflare Tunnel:Edit, Access: Apps and
# Policies:Edit, Zero Trust:Edit, and Device Posture:Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# The single identity the Access policy admits.
USER_EMAIL=
# Zero Trust team name: dash.cloudflare.com -> Zero Trust -> Settings. The split
# tunnel must carry <team>.cloudflareaccess.com or Access login has no route.
TEAM_NAME=

# The name given to the tunnel, the route, the policy and the Access application.
# A variable, not a literal, so an account whose objects already exist under a
# different name is adopted without a rename: set it to what the account carries.
APP_NAME=portable-dev
