<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fff" />
    <meta name="description" content="Dev servers reachable on this device." />
    <title>Portable Dev</title>
    <link rel="icon" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
  </head>
  <body>
    <header>
      <h1>Portable Dev</h1>
      <label class="toggle">
        <span>List</span>
        <input type="checkbox" id="view" role="switch" aria-label="Show tiles instead of a list" />
        <span>Tiles</span>
      </label>
    </header>

    <main id="servers" class="list" aria-live="polite">
      <p class="notice">Loading…</p>
    </main>

    <script>
      import { renderServers, type Server } from "../servers";

      const main = document.getElementById("servers") as HTMLElement;
      const view = document.getElementById("view") as HTMLInputElement;

      view.checked = localStorage.getItem("view") === "tile";
      const applyView = () => {
        const mode = view.checked ? "tile" : "list";
        main.className = mode;
        localStorage.setItem("view", mode);
      };
      view.addEventListener("change", applyView);
      applyView();

      // Re-render only on change, so polling does not flicker the list.
      let last = "";
      const load = async () => {
        try {
          const response = await fetch("/api/servers");
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const body = await response.text();
          if (body === last) return;
          last = body;
          renderServers(main, JSON.parse(body) as Server[]);
        } catch (error) {
          last = "";
          main.replaceChildren(
            Object.assign(document.createElement("p"), {
              className: "notice",
              textContent: `Cannot reach the Portable Dev server (${error}).`,
            }),
          );
        }
      };
      load();
      setInterval(load, 5000);
      document.addEventListener("visibilitychange", () => !document.hidden && load());

      // Absent unless the page is a secure context — see README, "PWA install".
      navigator.serviceWorker?.register("/sw.js");
    </script>

    <!--
      is:global is load-bearing. Astro scopes a <style> block by stamping
      data-astro-cid-* on the elements in this template, and every card is built
      by servers.ts at runtime, so it never gets the attribute. Scoped rules
      match nothing and the list renders unstyled. Card rules stay under
      #servers so "global" still means one subtree.
    -->
    <style is:global>
      :root {
        --line: #e4e4e7;
        --muted: #71717a;
        --card: #fff;
        --up: #16a34a;
        --down: #d4d4d8;
        color-scheme: light;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0 auto;
        padding: 1.25rem 1rem 3rem;
        max-width: 46rem;
        background: #fafafa;
        color: #18181b;
        font: 1rem/1.5 system-ui, sans-serif;
      }
      header {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
      }
      h1 { margin: 0; font-size: 1.35rem; }

      .toggle {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        color: var(--muted);
        font-size: 0.85rem;
        user-select: none;
      }
      .toggle input {
        appearance: none;
        margin: 0;
        width: 2.5rem;
        height: 1.4rem;
        border: 1px solid var(--line);
        border-radius: 1rem;
        background: #f4f4f5;
        cursor: pointer;
        transition: background 0.15s;
      }
      .toggle input::after {
        content: "";
        display: block;
        width: 1rem;
        height: 1rem;
        margin: 0.15rem;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.25);
        transition: transform 0.15s;
      }
      .toggle input:checked { background: #18181b; }
      .toggle input:checked::after { transform: translateX(1.1rem); }
      .toggle input:focus-visible { outline: 2px solid #18181b; outline-offset: 2px; }

      #servers { display: grid; gap: 0.6rem; }
      #servers.tile { grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr)); }

      #servers .server {
        display: flex;
        gap: 0.7rem;
        align-items: center;
        padding: 0.85rem 1rem;
        border: 1px solid var(--line);
        border-radius: 0.75rem;
        background: var(--card);
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.04);
        color: inherit;
        text-decoration: none;
      }
      #servers .server:active { border-color: #a1a1aa; }
      #servers .server:focus-visible { outline: 2px solid #18181b; outline-offset: 2px; }

      #servers .dot {
        flex: none;
        width: 0.55rem;
        height: 0.55rem;
        border-radius: 50%;
        background: var(--down);
      }
      #servers .up .dot { background: var(--up); }
      #servers .down { color: var(--muted); }

      /* Constrained hard: a repo favicon is often 512px square. */
      #servers .icon {
        flex: none;
        width: 2.25rem;
        height: 2.25rem;
        object-fit: contain;
        border-radius: 0.25rem;
      }
      /* The dot is the fallback; an icon beside it takes the slot instead. */
      #servers .server:has(.icon) .dot { display: none; }
      #servers .down .icon { filter: grayscale(1); opacity: 0.4; }

      #servers .body { flex: 1; display: grid; min-width: 0; }
      #servers .name { font-weight: 600; }
      #servers .name,
      #servers .description {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      #servers .description,
      #servers .port { color: var(--muted); font-size: 0.82rem; }
      #servers .port { flex: none; font-variant-numeric: tabular-nums; }

      #servers.tile .server {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
        padding: 1rem;
        min-height: 9rem;
      }
      #servers.tile .icon { width: 4.5rem; height: 4.5rem; }
      #servers.tile .dot { margin: 0.85rem 0; }
      #servers.tile .body { flex: 1; width: 100%; align-content: start; }
      #servers.tile .description { white-space: normal; }
      #servers.tile .port { align-self: flex-start; }

      .notice { color: var(--muted); }
    </style>
  </body>
</html>
