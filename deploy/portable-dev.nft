# Rendered by make (sed): @BIND_ADDR@ @PORTS@. The lo alias is topology, this is
# enforcement — Linux's weak host model delivers a packet for a local address
# whatever interface it arrived on, so a LAN peer with a static route could
# otherwise reach every dev server on it.
table inet portable-dev
flush table inet portable-dev
table inet portable-dev {
  chain input {
    type filter hook input priority filter; policy accept;
    iifname != "lo" ip daddr @BIND_ADDR@ tcp dport @PORTS@ drop
  }
}
